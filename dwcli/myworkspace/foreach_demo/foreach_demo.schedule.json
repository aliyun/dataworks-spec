{
  "version": "1.0",
  "kind": "CycleWorkflow",
  "metadata": {
    "name": "foreach_demo",
    "owner": "test_user"
  },
  "spec": {
    "nodes": [
      {
        "id": "foreach_demo",
        "name": "foreach_demo",
        "type": "VIRTUAL",
        "script": {
          "path": "foreach_demo",
          "runtime": {
            "command": "CONTROLLER_FOREACH"
          }
        },
        "for-each": {
          "array": {
            "id": "loop_array",
            "name": "loop_array",
            "scope": "NodeParameter",
            "type": "Constant",
            "value": "[1,2,3]"
          },
          "nodes": [
            {
              "id": "foreach_demo_start",
              "name": "foreach_demo_start",
              "type": "VIRTUAL",
              "script": {
                "path": "foreach_demo_start.sh",
                "runtime": {
                  "command": "CONTROLLER_TRAVERSE_START"
                }
              }
            },
            {
              "id": "foreach_demo_sql",
              "name": "foreach_demo_sql",
              "type": "ODPS_SQL",
              "script": {
                "path": "foreach_demo_sql.sql",
                "runtime": {
                  "command": "ODPS_SQL"
                }
              }
            },
            {
              "id": "foreach_demo_shell",
              "name": "foreach_demo_shell",
              "type": "DIDE_SHELL",
              "script": {
                "path": "foreach_demo_shell.sh",
                "runtime": {
                  "command": "DIDE_SHELL"
                }
              }
            },
            {
              "id": "foreach_demo_end",
              "name": "foreach_demo_end",
              "type": "VIRTUAL",
              "script": {
                "path": "foreach_demo_end.sh",
                "runtime": {
                  "command": "CONTROLLER_TRAVERSE_END"
                }
              }
            }
          ],
          "flow": [
            {
              "nodeId": "foreach_demo_sql",
              "depends": [
                {
                  "nodeId": "foreach_demo_start"
                }
              ]
            },
            {
              "nodeId": "foreach_demo_shell",
              "depends": [
                {
                  "nodeId": "foreach_demo_sql"
                }
              ]
            },
            {
              "nodeId": "foreach_demo_end",
              "depends": [
                {
                  "nodeId": "foreach_demo_shell"
                }
              ]
            }
          ]
        }
      }
    ],
    "flow": []
  }
}
