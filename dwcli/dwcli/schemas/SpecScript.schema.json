{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecScript json schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "extension": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        }
      },
      "required": [
        "command"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "content": {
      "type": "string"
    }
  },
  "additionalProperties": false
}