{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecWorkspace json schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "Workspace"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "required": [
    "version",
    "kind",
    "metadata"
  ],
  "additionalProperties": false
}