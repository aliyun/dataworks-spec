{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecForEach json schema",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "classpath:spec/schema/SpecNode.schema.json"
      },
      "minItems": 1
    },
    "array": {
      "type": "object"
    },
    "flow": {
      "type": "array",
      "items": {
        "$ref": "classpath:spec/schema/SpecFlowDepend.schema.json"
      }
    },
    "maxIterations": {
      "type": "integer"
    }
  },
  "required": [
    "nodes"
  ],
  "additionalProperties": false
}