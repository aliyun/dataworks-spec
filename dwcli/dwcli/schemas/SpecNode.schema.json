{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecNode json schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "recurrence": {
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "timeout": {
      "type": "integer"
    },
    "instanceMode": {
      "type": "string"
    },
    "rerunMode": {
      "type": "string"
    },
    "rerunTimes": {
      "type": "integer"
    },
    "rerunInterval": {
      "type": "integer"
    },
    "ignoreBranchConditionSkip": {
      "type": "boolean"
    },
    "autoParse": {
      "type": "boolean"
    },
    "datasource": {
      "type": "object"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "script": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "engine": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ]
        }
      },
      "required": [
        "path"
      ]
    },
    "trigger": {
      "type": "object"
    },
    "runtimeResource": {
      "type": "object"
    },
    "fileResources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "branch": {
      "type": "object"
    },
    "join": {
      "type": "object"
    },
    "doWhile": {
      "type": "object"
    },
    "foreach": {
      "type": "object"
    },
    "combined": {
      "type": "object"
    },
    "paramHub": {
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "strategy": {
      "type": "object"
    },
    "subflow": {
      "type": "object"
    },
    "paiflow": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "script"
  ],
  "additionalProperties": false
}