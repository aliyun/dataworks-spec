{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecFileResource json schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Resource name."
    },
    "script": {
      "type": "object"
    },
    "runtimeResource": {
      "type": "object"
    },
    "type": {
      "type": "string",
      "enum": [
        "python",
        "jar",
        "archive",
        "file"
      ]
    },
    "file": {
      "type": "object"
    },
    "datasource": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "type",
    "script"
  ],
  "additionalProperties": false
}