{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "CycleWorkflow Schema",
  "description": "Schema for DataWorks CycleWorkflow specification",
  "required": ["version", "kind", "spec"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Spec version",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "kind": {
      "type": "string",
      "description": "Workflow type",
      "enum": ["CycleWorkflow", "Node"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Workflow name"
        },
        "owner": {
          "type": "string",
          "description": "Workflow owner"
        },
        "description": {
          "type": "string",
          "description": "Workflow description"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["nodes"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "description": "List of workflow nodes",
          "items": {
            "type": "object",
            "required": ["id", "name", "type"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Node ID"
              },
              "name": {
                "type": "string",
                "description": "Node name"
              },
              "type": {
                "type": "string",
                "description": "Node type",
                "enum": [
                  "ODPS_SQL",
                  "SHELL",
                  "DIDE_SHELL",
                  "PYTHON",
                  "SPARK",
                  "FLINK",
                  "EMR_HIVE",
                  "EMR_SPARK",
                  "VIRTUAL"
                ]
              },
              "recurrence": {
                "type": "string",
                "description": "Recurrence pattern"
              },
              "priority": {
                "type": "integer"
              },
              "timeout": {
                "type": "integer",
                "description": "Timeout in seconds",
                "minimum": 0,
                "maximum": 86400
              },
              "instanceMode": {
                "type": "string"
              },
              "rerunMode": {
                "type": "string"
              },
              "rerunTimes": {
                "type": "integer"
              },
              "rerunInterval": {
                "type": "integer"
              },
              "ignoreBranchConditionSkip": {
                "type": "boolean"
              },
              "autoParse": {
                "type": "boolean"
              },
              "datasource": {
                "type": "object"
              },
              "datasets": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "script": {
                "type": "object",
                "required": ["path", "runtime"],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Script file path"
                  },
                  "runtime": {
                    "type": "object",
                    "description": "Runtime configuration",
                    "properties": {
                      "command": {
                        "type": "string",
                        "description": "Runtime command - must be a valid CodeProgramType enum value",
                        "enum": [
                          "SHELL", "DIDE_SHELL", "PERL", "SUB_PROCESS", "VIRTUAL_WORKFLOW", 
                          "WORKFLOW", "COMBINED_NODE", "VIRTUAL", "CONTROLLER_ASSIGNMENT",
                          "CONTROLLER_BRANCH", "CONTROLLER_JOIN", "CONTROLLER_CYCLE",
                          "CONTROLLER_CYCLE_START", "CONTROLLER_CYCLE_END", "CONTROLLER_TRAVERSE",
                          "CONTROLLER_TRAVERSE_START", "CONTROLLER_TRAVERSE_END", "CONTROLLER_WAIT",
                          "SCHEDULER_TRIGGER", "PARAM_HUB", "FTP_CHECK", "SSH", "CHECK",
                          "CHECK_NODE", "OSS_INSPECT", "CROSS_TENANTS", "PYTHON",
                          "DATA_SYNCHRONIZATION_QUALITY_CHECK", "DATA_PUSH", "DATA_QUALITY_MONITOR",
                          "HIVE", "YSF_DESEN", "ODPS_XLIB", "ODPS_PERL", "ODPS_SQL",
                          "LIGHTNING_SQL", "EXTREME_STORAGE", "ODPS_SPARK_SQL", "ODPS_MR",
                          "PYODPS3", "ODPS_SCRIPT", "PYODPS", "ODPS_SHARK", "ODPS_SPARK",
                          "SHARK_RESOURCE", "COMPONENT_SQL", "SQL_COMPONENT", "ODPS_PYTHON",
                          "ODPS_JAR", "ODPS_ARCHIVE", "ODPS_FILE", "ODPS_DDL", "ODPS_TABLE",
                          "ODPS_FUNCTION", "DATASERVICE_STUDIO", "DATAX", "DATAX2", "DT",
                          "CDP", "DI", "RI", "DD_MERGE", "TT_MERGE", "EMR_HIVE",
                          "EMR_SPARK", "EMR_SPARK_SQL", "EMR_MR", "EMR_SHELL", "EMR_SPARK_SHELL",
                          "EMR_PRESTO", "EMR_IMPALA", "EMR_SCOOP", "EMR_SPARK_STREAMING",
                          "EMR_HIVE_CLI", "EMR_STREAMING_SQL", "EMR_TRINO", "EMR_KYUUBI",
                          "EMR_JAR", "EMR_FILE", "EMR_TABLE", "EMR_FUNCTION", "CDH_HIVE",
                          "CDH_SPARK", "CDH_SPARK_SQL", "CDH_MR", "CDH_SHELL", "CDH_SPARK_SHELL",
                          "CDH_PRESTO", "CDH_IMPALA", "CDH_JAR", "CDH_FILE", "CDH_TABLE",
                          "CDH_FUNCTION", "PAI", "PAI_STUDIO", "RECOMMEND_PLUS", "PAI_DLC",
                          "ALINK", "XLAB", "PAI_FLOW", "HOLOGRES_DEVELOP", "HOLOGRES_SYNC",
                          "HOLOGRES_SQL", "HOLOGRES_SYNC_DDL", "HOLOGRES_SYNC_DATA",
                          "HOLOGRES_SYNC_DATA_TO_MC", "BLINK_SQL", "FLINK_SQL_BATCH",
                          "FLINK_SQL_STREAM", "BLINK_BATCH_SQL", "BLINK_DATASTREAM",
                          "CLICK_SQL", "POSTGRESQL", "MYSQL", "SQLSERVER", "Oracle",
                          "StarRocks", "DRDS", "Doris", "Mariadb", "Selectdb", "Redshift",
                          "Saphana", "Vertica", "OceanBase", "DB2", "ADB_for_PostgreSQL",
                          "ADB_for_MySQL", "ADB_SPARK", "ADB_SPARK_SQL", "SERVERLESS_SPARK_BATCH",
                          "SERVERLESS_SPARK_SQL", "SERVERLESS_SPARK_STREAMING", "SERVERLESS_KYUUBI",
                          "CUSTOM"
                        ]
                      },
                      "engine": {
                        "type": "string",
                        "description": "Runtime engine"
                      }
                    },
                    "required": ["command"]
                  }
                }
              },
              "trigger": {
                "type": "object",
                "description": "Node trigger configuration",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "cron": {
                    "type": "string",
                    "description": "Cron expression for scheduled triggers"
                  },
                  "cycleType": {
                    "type": "string"
                  },
                  "recurrence": {
                    "type": "string"
                  },
                  "startTime": {
                    "type": "string"
                  },
                  "endTime": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "delaySeconds": {
                    "type": "integer"
                  },
                  "calendarId": {
                    "type": "integer"
                  },
                  "identifier": {
                    "type": "string"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "type"
                    ]
                  },
                  {
                    "required": [
                      "recurrence"
                    ]
                  }
                ],
                "additionalProperties": false
              },
              "runtimeResource": {
                "type": "object"
              },
              "fileResources": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "functions": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "inputs": {
                "type": "object"
              },
              "outputs": {
                "type": "object"
              },
              "branch": {
                "type": "object"
              },
              "join": {
                "type": "object"
              },
              "doWhile": {
                "type": "object"
              },
              "foreach": {
                "type": "object"
              },
              "combined": {
                "type": "object"
              },
              "paramHub": {
                "type": "object"
              },
              "owner": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "strategy": {
                "type": "object"
              },
              "subflow": {
                "type": "object"
              },
              "paiflow": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "flow": {
          "type": "array",
          "description": "Node dependencies",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "description": "Target node ID"
              },
              "depends": {
                "type": "array",
                "description": "Dependency configurations",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Dependency node ID (legacy format)"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "Dependency type",
                          "enum": [
                            "Normal",
                            "CrossCycleDependsOnSelf",
                            "CrossCycleDependsOnChildren",
                            "CrossCycleDependsOnOtherNode"
                          ]
                        },
                        "output": {
                          "type": "string",
                          "description": "Output node data from upstream node's outputs.nodeOutputs.data field"
                        }
                      },
                      "required": ["type", "output"],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": ["nodeId"],
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "description": "Workflow dependencies",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "description": "Target node ID"
              },
              "depends": {
                "type": "array",
                "description": "Dependency node IDs",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "workflows": {
          "type": "array",
          "description": "List of sub-workflows",
          "items": {
            "type": "object"
          }
        },
        "fileResources": {
          "type": "array",
          "description": "List of file resources",
          "items": {
            "type": "object"
          }
        },
        "functions": {
          "type": "array",
          "description": "List of functions",
          "items": {
            "type": "object"
          }
        },
        "components": {
          "type": "array",
          "description": "List of components",
          "items": {
            "type": "object"
          }
        },
        "variables": {
          "type": "array",
          "description": "List of variables",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}