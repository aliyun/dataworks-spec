{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "CycleWorkflow Schema",
  "description": "Schema for DataWorks CycleWorkflow specification",
  "required": ["version", "kind", "spec"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Spec version",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "kind": {
      "type": "string",
      "description": "Workflow type",
      "enum": ["CycleWorkflow", "Node"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Workflow name"
        },
        "owner": {
          "type": "string",
          "description": "Workflow owner"
        },
        "description": {
          "type": "string",
          "description": "Workflow description"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["nodes"],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "description": "List of workflow nodes",
          "items": {
            "type": "object",
            "required": ["id", "name", "type"],
            "properties": {
              "id": {
                "type": "string",
                "description": "Node ID"
              },
              "name": {
                "type": "string",
                "description": "Node name"
              },
              "type": {
                "type": "string",
                "description": "Node type",
                "enum": [
                  "ODPS_SQL",
                  "SHELL",
                  "DIDE_SHELL",
                  "PYTHON",
                  "SPARK",
                  "FLINK",
                  "EMR_HIVE",
                  "EMR_SPARK",
                  "VIRTUAL"
                ]
              },
              "recurrence": {
                "type": "string",
                "description": "Recurrence pattern"
              },
              "priority": {
                "type": "integer"
              },
              "timeout": {
                "type": "integer",
                "description": "Timeout in seconds",
                "minimum": 0,
                "maximum": 86400
              },
              "instanceMode": {
                "type": "string"
              },
              "rerunMode": {
                "type": "string"
              },
              "rerunTimes": {
                "type": "integer"
              },
              "rerunInterval": {
                "type": "integer"
              },
              "ignoreBranchConditionSkip": {
                "type": "boolean"
              },
              "autoParse": {
                "type": "boolean"
              },
              "datasource": {
                "type": "object"
              },
              "datasets": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "script": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Script file path"
                  },
                  "runtime": {
                    "type": "object",
                    "description": "Runtime configuration",
                    "properties": {
                      "command": {
                        "type": "string",
                        "description": "Runtime command"
                      },
                      "engine": {
                        "type": "string",
                        "description": "Runtime engine"
                      }
                    },
                    "required": ["command"]
                  }
                }
              },
              "trigger": {
                "type": "object",
                "description": "Node trigger configuration",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "cron": {
                    "type": "string",
                    "description": "Cron expression for scheduled triggers"
                  },
                  "cycleType": {
                    "type": "string"
                  },
                  "recurrence": {
                    "type": "string"
                  },
                  "startTime": {
                    "type": "string"
                  },
                  "endTime": {
                    "type": "string"
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "delaySeconds": {
                    "type": "integer"
                  },
                  "calendarId": {
                    "type": "integer"
                  },
                  "identifier": {
                    "type": "string"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "type"
                    ]
                  },
                  {
                    "required": [
                      "recurrence"
                    ]
                  }
                ],
                "additionalProperties": false
              },
              "runtimeResource": {
                "type": "object"
              },
              "fileResources": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "functions": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "inputs": {
                "type": "object"
              },
              "outputs": {
                "type": "object"
              },
              "branch": {
                "type": "object"
              },
              "join": {
                "type": "object"
              },
              "doWhile": {
                "type": "object"
              },
              "foreach": {
                "type": "object"
              },
              "combined": {
                "type": "object"
              },
              "paramHub": {
                "type": "object"
              },
              "owner": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "strategy": {
                "type": "object"
              },
              "subflow": {
                "type": "object"
              },
              "paiflow": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "flow": {
          "type": "array",
          "description": "Node dependencies",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "description": "Target node ID"
              },
              "depends": {
                "type": "array",
                "description": "Dependency node IDs",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "description": "Workflow dependencies",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "description": "Target node ID"
              },
              "depends": {
                "type": "array",
                "description": "Dependency node IDs",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "workflows": {
          "type": "array",
          "description": "List of sub-workflows",
          "items": {
            "type": "object"
          }
        },
        "fileResources": {
          "type": "array",
          "description": "List of file resources",
          "items": {
            "type": "object"
          }
        },
        "functions": {
          "type": "array",
          "description": "List of functions",
          "items": {
            "type": "object"
          }
        },
        "components": {
          "type": "array",
          "description": "List of components",
          "items": {
            "type": "object"
          }
        },
        "variables": {
          "type": "array",
          "description": "List of variables",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}