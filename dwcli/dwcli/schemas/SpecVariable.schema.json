{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecVariable json schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "Variable"
      ],
      "description": "Artifact type, fixed to 'VARIABLE'."
    },
    "inputName": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Name of the variable."
    },
    "scope": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "description": "Value of the variable."
    },
    "description": {
      "type": "string",
      "description": "Description of the variable."
    },
    "referenceVariable": {
      "type": "object"
    },
    "node": {
      "type": "object"
    }
  },
  "required": [
    "name",
    "type",
    "scope",
    "artifactType"
  ],
  "additionalProperties": false
}