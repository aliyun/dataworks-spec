{
  "spec": {
    "version": "2.0.0",
    "kind": "Node",
    "spec": {
      "nodes": [
        {
          "id": "{{ name }}",
          "name": "{{ name }}",
          "type": "SHELL",
          "timeout": 3600,
          "script": {
            "path": "{{ name }}.sh",
            "runtime": {
              "command": "SHELL"
            }
          }
        }
      ],
      "flow": []
    }
  },
  "code": {
    "extension": "sh",
    "content": "#!/bin/bash\n# Shell Script for {{ name }}\n# TODO: Add your shell logic here\n\necho \"Hello from {{ name }}\"\n"
  }
}