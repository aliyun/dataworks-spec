{
  "spec": {
    "version": "2.0.0",
    "kind": "Node",
    "spec": {
      "nodes": [
        {
          "id": "{{ name }}",
          "name": "{{ name }}",
          "type": "ODPS_SQL",
          "timeout": 3600,
          "script": {
            "path": "{{ name }}.sql",
            "runtime": {
              "command": "ODPS_SQL"
            }
          }
        }
      ],
      "flow": []
    }
  },
  "code": {
    "extension": "sql",
    "content": "-- SQL Script for {{ name }}\n-- TODO: Add your SQL logic here\n\nSELECT 1;\n"
  }
}