{
    "kind": "CycleWorkflow",
    "spec": {
        "workflows": [
            {
                "script": {
                    "path": "聿剑/openapi/workflow/{name}",
                    "runtime": {
                        "command": "WORKFLOW"
                    }
                },
                "name": "{name}",
                "recurrence": "Normal",
                "id": "5479743988095323770",
                "citable": false,
                "timeout": 0,
                "instanceMode": "T+1",
                "rerunMode": "Allowed",
                "rerunTimes": 3,
                "rerunInterval": 120000,
                "datasource": {
                    "name": "lwt_test_newIde_pro",
                    "type": "odps"
                },
                "trigger": {
                    "type": "Scheduler",
                    "cron": "00 26 00 * * ?",
                    "startTime": "1970-01-01 00:00:00",
                    "endTime": "9999-01-01 00:00:00",
                    "timezone": "GMT+08:00",
                    "delaySeconds": 0
                },
                "owner": "1107550004253538",
                "outputs": {
                    "nodeOutputs": [
                        {
                            "data": "lwt_test_newIde.mycustom_{name}_output1",
                            "artifactType": "NodeOutput",
