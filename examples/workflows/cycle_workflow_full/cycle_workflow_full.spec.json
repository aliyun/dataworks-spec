                            "isDefault": false
                        }
                    ]
                }
            }
        ],
        "flow": [
            {
                "nodeId": "5479743988095323770",
                "depends": [
                    {
                        "type": "Normal",
                        "output": "lwt_test_newide_root"
                    },
                    {
                        "output": "lwt_test_newIde.mycustom_{name}_input1",
                        "type": "Normal"
                    }
                ]
            }
        ]
    }
}